{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/billbrietstout/ai-security-whitepaper-monitor/schemas/whitepapers.schema.json",
  "title": "AI security whitepaper inventory",
  "description": "Export of the whitepaper inventory built from GitHub issues. version is the file format. Each WP- id stays on one normalized paper URL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "source",
    "repository",
    "sheet",
    "id_registry",
    "papers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "description": "Calendar date the export file was written, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "const": "github-issues"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "description": "The spreadsheet this inventory used to live in. status is retired. Code must not read or write that spreadsheet.",
      "required": ["status", "retired_on", "id"],
      "properties": {
        "status": { "const": "retired" },
        "retired_on": { "const": "2026-10-31" },
        "id": { "const": "161FFOVjQUNxiaOzMryT6sbEuYjq-uLf-vcDEHfvlFbE" }
      }
    },
    "id_registry": {
      "type": "array",
      "description": "Every WP- id ever assigned. An entry stays after its issue is closed. Entries are not removed and an id does not move to another URL.",
      "items": { "$ref": "#/$defs/registryEntry" }
    },
    "papers": {
      "type": "array",
      "items": { "$ref": "#/$defs/paper" }
    }
  },
  "$defs": {
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wp_id", "url", "issue_number"],
      "properties": {
        "wp_id": { "$ref": "#/$defs/wpId" },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Normalized paper URL. The host is lower case, the scheme is https, and a trailing slash is removed."
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Issue that received this id. The id stays on this issue."
        }
      }
    },
    "wpId": {
      "type": "string",
      "pattern": "^WP-[0-9]{4}$"
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wp_id",
        "issue_number",
        "issue_url",
        "state",
        "title",
        "source_org",
        "url",
        "date_published",
        "category",
        "file_type",
        "decision",
        "decision_reason",
        "summary",
        "legacy_sheet_url",
        "legacy_sheet_row",
        "legacy_notes",
        "blog_url",
        "duplicate_issue_numbers",
        "axioms",
        "invariables",
        "principles",
        "opencre_topics"
      ],
      "properties": {
        "wp_id": { "$ref": "#/$defs/wpId" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+$"
        },
        "state": { "enum": ["open", "closed"] },
        "title": { "type": "string", "minLength": 1 },
        "source_org": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "date_published": { "type": "string" },
        "category": { "type": "string" },
        "file_type": { "type": "string" },
        "decision": { "enum": ["include", "delete_candidate", "duplicate"] },
        "decision_reason": { "type": "string" },
        "summary": { "type": "string" },
        "legacy_sheet_url": { "type": "string" },
        "legacy_sheet_row": { "type": "string" },
        "legacy_notes": { "type": "string" },
        "blog_url": { "type": "string" },
        "duplicate_issue_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "axioms": { "$ref": "#/$defs/bulletList" },
        "invariables": { "$ref": "#/$defs/bulletList" },
        "principles": { "$ref": "#/$defs/bulletList" },
        "opencre_topics": { "$ref": "#/$defs/bulletList" }
      }
    },
    "bulletList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
